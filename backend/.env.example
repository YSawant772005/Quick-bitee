# QuickBite backend configuration — copy to .env for local (host) development.
# Inside Docker Compose every value has a working default; see compose.yaml.

# PostgreSQL (async SQLAlchemy URL)
DATABASE_URL=postgresql+asyncpg://quickbite:quickbite@localhost:5432/quickbite

# RabbitMQ
AMQP_URL=amqp://quickbite:quickbite@localhost:5672/

# JWT signing — MUST be overridden in any shared/real deployment
JWT_SECRET=dev-insecure-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS origins for Flutter Web (comma separated)
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Simulated stage delays (seconds)
SIM_PAYMENT_DELAY_SECONDS=0.4
SIM_RESTAURANT_DELAY_SECONDS=0.6
SIM_DELIVERY_DELAY_SECONDS=0.6
SIM_NOTIFICATION_DELAY_SECONDS=0.05

# Deterministic failure controls (none | twice_then_succeed | always_fail)
PAYMENT_FAILURE_MODE=none
# (none | always_fail)
RESTAURANT_FAILURE_MODE=none
DELIVERY_FAILURE_MODE=none
NOTIFICATION_FAILURE_MODE=none
# Crash injection for workers (none | before_tx | after_tx)
WORKER_CRASH_POINT=none

# Retry policy: comma separated delays in seconds (initial attempt + 3 retries, then quarantine)
RETRY_DELAYS_SECONDS=2,10,30

# Loops
OUTBOX_POLL_INTERVAL_SECONDS=0.5
OUTBOX_BATCH_SIZE=50
RETRY_SCHEDULER_INTERVAL_SECONDS=1.0

LOG_LEVEL=INFO
